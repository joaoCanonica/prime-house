---
// Layout das páginas internas: head, faixa de preview, cabeçalho com navegação (menu <details> no celular,
// sem JS), cabeçalho da página (rótulo, H1 com acento e parágrafo-resposta) e rodapé.
import '../styles/global.css';
import BotaoWhatsApp from '../components/base/BotaoWhatsApp.astro';
import Logo from '../components/marca/Logo.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import Rodape from '../components/secoes/Rodape.astro';
import { comAcento } from '../components/secoes/texto.ts';
import { robots } from '../config/seo.ts';
import { cores } from '../config/tema.ts';
import { navegacao } from '../content/textos/index.ts';
import type { Meta, Texto } from '../content/textos/tipos.ts';

interface Props {
  meta: Meta;
  rotulo: string;
  titulo: Texto;
  resposta: string;
  /** rota atual, para marcar o item do menu */
  rota: string;
  /** mensagem pronta do botão do cabeçalho */
  mensagem?: string | undefined;
  /** páginas como a 404 não levam o parágrafo-resposta à vista */
  semResposta?: boolean | undefined;
}
const { meta, rotulo, titulo, resposta, rota, mensagem, semResposta = false } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots()} />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content={cores.breu} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body>
    <a class="pular-conteudo" href="#conteudo">
      {navegacao.pularParaConteudo}
    </a>
    <PreviewBanner />
    <header class="cabecalho">
      <a href="/" class="cabecalho__logo">
        <Logo variante="linha" altura={20} decorativo />
        <span class="sr-only">Prime House Academia, início</span>
      </a>
      <nav class="cabecalho__nav" aria-label={navegacao.principal}>
        <ul class="nav-desktop">
          {navegacao.itens.map((i) => (
            <li>
              <a href={i.href} aria-current={rota === i.href ? 'page' : undefined}>
                {i.rotulo}
              </a>
            </li>
          ))}
        </ul>
        <details class="menu">
          <summary class="menu__botao t-rotulo">Menu</summary>
          <ul class="menu__lista">
            {navegacao.itens.map((i) => (
              <li>
                <a href={i.href} aria-current={rota === i.href ? 'page' : undefined}>
                  {i.rotulo}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
      <BotaoWhatsApp class="cabecalho__cta" {...(mensagem ? { mensagem } : {})} />
    </header>
    <main id="conteudo" class="interna">
      <header class="interna__topo">
        <p class="t-rotulo interna__rotulo">{rotulo}</p>
        <h1 class="t-h1 interna__titulo" set:html={comAcento(titulo)} />
        <p class:list={['t-lead interna__resposta', { 'sr-only': semResposta }]}>{resposta}</p>
      </header>
      <slot />
    </main>
    <Rodape />
  </body>
</html>

<style is:global>
  .pular-conteudo {
    position: absolute;
    left: var(--esp-3);
    top: -4rem;
    z-index: 2000;
    padding: var(--esp-3) var(--esp-4);
    background: var(--prime-luz);
    color: var(--prime-breu);
    font-weight: 600;
  }
  .pular-conteudo:focus {
    top: var(--esp-3);
  }
  /* blocos comuns das internas */
  .bloco {
    padding-block: clamp(3rem, 1.5rem + 5vw, 7rem);
    border-top: 1px solid var(--prime-linha);
    display: grid;
    gap: var(--esp-6);
  }
  .bloco__titulo {
    max-width: 30ch;
  }
</style>

<style>
  .cabecalho {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--esp-4);
    padding: var(--esp-4) var(--margem);
    border-bottom: 1px solid var(--prime-linha);
  }
  .cabecalho__logo {
    color: var(--prime-nevoa);
    display: inline-flex;
    margin-inline-end: auto;
  }
  .menu {
    position: relative;
  }
  .menu__botao {
    list-style: none;
    cursor: pointer;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    padding: 0 var(--esp-3);
    border: 1px solid var(--prime-linha);
  }
  .menu__botao::-webkit-details-marker {
    display: none;
  }
  .menu__lista {
    list-style: none;
    padding: var(--esp-3);
    margin: 0;
    position: absolute;
    right: 0;
    top: calc(100% + var(--esp-2));
    min-width: 14rem;
    display: grid;
    gap: var(--esp-1);
    background: var(--prime-grafite);
    border: 1px solid var(--prime-linha);
  }
  .menu__lista a {
    display: block;
    padding: var(--esp-2) var(--esp-3);
    color: var(--prime-nevoa);
    text-decoration: none;
  }
  .menu__lista a:hover,
  .menu__lista a[aria-current='page'] {
    color: var(--prime-luz);
    box-shadow: inset 2px 0 0 var(--prime-luz);
  }
  .cabecalho :global(.cabecalho__cta) {
    display: none;
  }
  .nav-desktop {
    display: none;
  }
  @media (min-width: 64rem) {
    .menu {
      display: none;
    }
    .nav-desktop {
      display: flex;
      list-style: none;
      gap: var(--esp-2);
      padding: 0;
      margin: 0;
    }
    .nav-desktop a {
      display: block;
      padding: var(--esp-2);
      color: var(--prime-nevoa);
      text-decoration: none;
    }
    .nav-desktop a:hover,
    .nav-desktop a[aria-current='page'] {
      color: var(--prime-luz);
      box-shadow: inset 0 -1px 0 var(--prime-luz);
    }
    .cabecalho :global(.cabecalho__cta) {
      display: inline-flex;
      min-height: 2.75rem;
      padding: 0.6rem 1rem;
    }
  }
  .interna {
    width: min(100% - 2 * var(--margem), var(--largura-max));
    margin-inline: auto;
    padding-bottom: var(--secao);
  }
  .interna__topo {
    display: grid;
    gap: var(--esp-4);
    padding-block: clamp(3rem, 1.5rem + 5vw, 7rem) clamp(2rem, 1rem + 3vw, 4rem);
    max-width: 62rem;
  }
  .interna__rotulo {
    color: var(--prime-concreto);
  }
  .interna__resposta {
    max-width: 52ch;
    color: var(--prime-concreto);
  }
</style>
