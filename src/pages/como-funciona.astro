---
// /como-funciona — gesto: um percurso numerado em linha de luz (contato → … → reavaliação), o vídeo da avaliação
// com a fala em HTML, o fisioterapeuta e o treino "orientado e adaptado".
import BotaoWhatsApp from '../components/base/BotaoWhatsApp.astro';
import MolduraVideo from '../components/base/MolduraVideo.astro';
import Txt from '../components/secoes/Txt.astro';
import Interna from '../layouts/Interna.astro';
import { comoFunciona as c, legendas, videos, whatsapp } from '../content/textos/index.ts';
---

<Interna
  meta={c.meta}
  rotulo="Como funciona"
  titulo={c.titulo}
  resposta={c.resposta}
  rota="/como-funciona"
  mensagem={whatsapp.avaliacao}
>
  <ol class="cf__passos">
    {c.passos.map((p, i) => (
      <li class="cf__passo">
        <span class="cf__n t-tabular" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h2 class="cf__titulo">{p.titulo}</h2>
        <Txt texto={p.texto} class="cf__texto" />
        {'complemento' in p && p.complemento && <p class="cf__comp t-pequeno">{p.complemento}</p>}
      </li>
    ))}
  </ol>

  <section class="bloco cf__avaliacao" aria-labelledby="avaliacao">
    <div class="cf__video">
      <MolduraVideo id="avaliacao-funcional" descricao={videos['avaliacao-funcional']} />
    </div>
    <div class="cf__avaliacao-texto">
      <h2 id="avaliacao" class="t-h2">
        Avaliação <em class="acento">funcional</em>
      </h2>
      <p class="t-lead">{c.porQue.texto}</p>
      <details class="cf__fala">
        <summary class="t-rotulo">Ler o que o Lucas diz no vídeo</summary>
        <p>{legendas['avaliacao-funcional']}</p>
      </details>
      <BotaoWhatsApp mensagem={whatsapp.avaliacao} texto={c.botao} />
    </div>
  </section>

  <section class="bloco" aria-labelledby="fisio">
    <h2 id="fisio" class="t-h2 bloco__titulo">
      {c.fisioterapeuta.titulo}
    </h2>
    <p class="t-lead cf__largo">{c.fisioterapeuta.texto}</p>
  </section>

  <section class="bloco cf__adaptado" aria-labelledby="adaptado">
    <Txt texto={c.adaptado.titulo} como="h2" class="t-h2 bloco__titulo" />
    <p class="t-lead cf__largo">{c.adaptado.texto}</p>
    <ul class="cf__grupos" aria-label="Para quem">
      {c.adaptado.grupos.map((g) => (
        <li>{g}</li>
      ))}
    </ul>
    <p class="cf__aviso t-pequeno">{c.adaptado.aviso}</p>
    <p class="cf__frase">{c.adaptado.frase.texto}</p>
    <BotaoWhatsApp mensagem={whatsapp.adaptado.mais40} texto="Conversar sobre treino adaptado" />
  </section>
</Interna>

<style>
  .cf__passos {
    list-style: none;
    padding: 0 0 var(--esp-8);
    margin: 0;
    display: grid;
    gap: var(--esp-6);
    counter-reset: passo;
  }
  .cf__passo {
    position: relative;
    display: grid;
    gap: var(--esp-2);
    padding: var(--esp-5) 0 0 var(--esp-6);
    max-width: none;
  }
  .cf__passo::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: calc(-1 * var(--esp-6));
    width: 1px;
    background: rgb(255 244 224 / 0.4);
  }
  .cf__passo:last-child::before {
    bottom: 0;
  }
  .cf__passo::after {
    content: '';
    position: absolute;
    left: -4px;
    top: var(--esp-5);
    width: 9px;
    height: 9px;
    background: var(--prime-luz);
    box-shadow: 0 0 10px rgb(255 244 224 / 0.8);
  }
  .cf__n {
    color: var(--prime-laranja);
    font-family: var(--fonte-titulo);
    font-stretch: var(--largura-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
  }
  .cf__titulo {
    font-family: var(--fonte-titulo);
    font-stretch: var(--largura-titulo);
    font-weight: 680;
    text-transform: uppercase;
    font-size: var(--fs-h3);
  }
  .cf__passo :global(.cf__texto) {
    max-width: 52ch;
  }
  .cf__comp {
    color: var(--prime-concreto);
  }
  .cf__avaliacao {
    align-items: start;
  }
  .cf__video {
    width: min(100%, 20rem);
  }
  .cf__avaliacao-texto {
    display: grid;
    gap: var(--esp-5);
    align-content: start;
  }
  .cf__fala summary {
    cursor: pointer;
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    color: var(--prime-concreto);
  }
  .cf__fala p {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.4;
    max-width: 46ch;
    padding-top: var(--esp-3);
  }
  .cf__largo {
    max-width: 52ch;
  }
  .cf__grupos {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .cf__grupos li {
    padding: 0.5rem 1rem;
    border: 1px solid rgb(255 244 224 / 0.45);
  }
  .cf__aviso {
    color: var(--prime-concreto);
    max-width: 60ch;
    border-left: 1px solid var(--prime-luz);
    padding-left: var(--esp-4);
  }
  .cf__frase {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.5rem);
  }
  @media (min-width: 64rem) {
    .cf__passos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: var(--esp-7);
    }
    .cf__passo {
      padding: var(--esp-6) var(--esp-4) 0 0;
    }
    .cf__passo::before {
      left: 0;
      right: calc(-1 * var(--esp-6));
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .cf__passo:nth-child(3n)::before {
      right: 0;
    }
    .cf__passo::after {
      left: 0;
      top: -4px;
    }
    .cf__avaliacao {
      grid-template-columns: minmax(16rem, 22rem) minmax(0, 1fr);
      column-gap: var(--esp-8);
    }
  }
</style>
