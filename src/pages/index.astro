---
// Home. Nesta sessão: só a abertura e o hero (as demais seções vêm na sessão 6A).
import '../styles/global.css';
import Abertura from '../components/abertura/Abertura.astro';
import Hero from '../components/hero/Hero.astro';
import PreviewBanner from '../components/PreviewBanner.astro';
import { cores } from '../config/tema.ts';
import { robots } from '../config/seo.ts';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots()} />
    <title>Prime House Academia · Lages/SC</title>
    <meta name="theme-color" content={cores.breu} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Abertura />
    <PreviewBanner />
    <main>
      <Hero midia="interior-noite" />
    </main>
  </body>
</html>
