---
// /planos — gesto: três colunas lado a lado como uma tabela de leitura (sem preço), CTA por plano;
// benefícios fixos só confirmados (preview: selo PROVISÓRIO); convênio; perguntas em <details>.
// Vídeos plano-prime (naoUsar) e plano-select (consentimento pendente) ficam fora até serem liberados.
import BotaoWhatsApp from '../components/base/BotaoWhatsApp.astro';
import EscolhaPlano from '../components/base/EscolhaPlano.astro';
import Provisorio from '../components/Provisorio.astro';
import Txt from '../components/secoes/Txt.astro';
import { modoAtual } from '../config/modo.ts';
import Interna from '../layouts/Interna.astro';
import { planos, whatsapp } from '../content/textos/index.ts';

const p = planos.itens;
const colunas = [
  { id: 'prime', ...p.prime, gancho: null, msg: whatsapp.planoPrime },
  { id: 'select', ...p.select, msg: whatsapp.planoSelect },
  { id: 'duo', ...p.duo, gancho: null, msg: whatsapp.planoDuo },
];
const preview = modoAtual() === 'preview';
---

<Interna
  meta={planos.meta}
  rotulo="Planos"
  titulo={planos.titulo}
  resposta={planos.resposta}
  rota="/planos"
>
  <section class="pl" aria-label="Os três planos">
    {colunas.map((c, i) => (
      <article class:list={['pl__col', { 'pl__col--select': c.id === 'select' }]}>
        <span class="pl__n t-tabular" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <h2 class="pl__nome">{c.nome}</h2>
        {c.gancho && <Txt texto={c.gancho} class="pl__gancho" />}
        <Txt texto={c.resumo} class="pl__resumo" />
        <BotaoWhatsApp
          mensagem={c.msg}
          texto={c.botao}
          class="pl__cta"
          origem="pagina-planos"
          plano={c.id}
        />
      </article>
    ))}
  </section>

  <section class="bloco">
    <EscolhaPlano />
  </section>

  {preview && (
    <section class="bloco" aria-labelledby="beneficios">
      <h2 id="beneficios" class="t-h2 bloco__titulo">
        {planos.beneficios.titulo}
      </h2>
      <ul class="pl__beneficios">
        {planos.beneficios.itens.map((b) => (
          <li>
            <Provisorio motivo={b.texto.motivo} como="div">
              <h3 class="t-h3">{b.titulo}</h3>
              <p>{b.texto.texto}</p>
            </Provisorio>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="bloco pl__convenio" aria-labelledby="convenio">
    <h2 id="convenio" class="t-h2 bloco__titulo">
      {planos.convenio.titulo}
    </h2>
    <p class="t-lead">{planos.convenio.texto}</p>
    <BotaoWhatsApp mensagem={whatsapp.convenio} texto="Perguntar sobre o convênio" />
  </section>

  <section class="bloco" aria-labelledby="perguntas">
    <h2 id="perguntas" class="t-h2 bloco__titulo">
      Perguntas sobre os planos
    </h2>
    <div class="pl__faq">
      {planos.perguntas.map((q) => (
        <details>
          <summary>{q.p}</summary>
          <p>{q.r}</p>
        </details>
      ))}
    </div>
    <p class="t-lead">{planos.chamada}</p>
  </section>
</Interna>

<style>
  .pl {
    display: grid;
    border-top: 1px solid var(--prime-linha);
  }
  .pl__col {
    display: grid;
    align-content: start;
    gap: var(--esp-4);
    padding: var(--esp-6) 0 var(--esp-7);
    border-bottom: 1px solid var(--prime-linha);
  }
  .pl__n {
    color: var(--prime-concreto);
    font-size: var(--fs-pequeno);
  }
  .pl__nome {
    font-family: var(--fonte-titulo);
    font-stretch: var(--largura-display);
    font-weight: 740;
    text-transform: uppercase;
    font-size: clamp(2.75rem, 1.8rem + 3.4vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: var(--ls-display);
  }
  .pl :global(.pl__gancho) {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: 1.375rem;
    line-height: 1.3;
  }
  .pl :global(.pl__resumo) {
    color: var(--prime-concreto);
    max-width: 34ch;
  }
  .pl :global(.pl__cta) {
    justify-self: start;
  }
  .pl__col--select {
    padding-inline: var(--esp-5);
    outline: 1px solid var(--prime-luz);
    outline-offset: -1px;
    box-shadow: 0 0 16px rgb(255 244 224 / 0.2);
  }
  .pl__beneficios {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .pl__beneficios li {
    max-width: none;
  }
  .pl__beneficios :global(.ph-provisorio) {
    display: grid;
    gap: var(--esp-2);
    padding: var(--esp-4);
  }
  .pl__faq {
    display: grid;
    border-top: 1px solid var(--prime-linha);
    max-width: 52rem;
  }
  .pl__faq details {
    border-bottom: 1px solid var(--prime-linha);
  }
  .pl__faq summary {
    cursor: pointer;
    padding: var(--esp-4) 0;
    font-weight: 600;
  }
  .pl__faq p {
    padding-bottom: var(--esp-4);
    color: var(--prime-concreto);
  }
  @media (min-width: 64rem) {
    .pl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 0;
      gap: var(--esp-5);
    }
    .pl__col {
      padding-inline: var(--esp-5);
      border-bottom: 0;
      border-top: 1px solid var(--prime-linha);
    }
    .pl__col--select {
      border-top-color: transparent;
    }
  }
</style>
