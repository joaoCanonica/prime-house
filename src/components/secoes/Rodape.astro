---
// 11 · RODAPÉ — logo, endereço, WhatsApp e telefone escritos, horário, Instagram, CREF e CNPJ (quando informados),
// trabalhe conosco e privacidade.
import Link from '../base/Link.astro';
import Logo from '../marca/Logo.astro';
import Consentimento from '../consentimento/Consentimento.astro';
import { contato } from '../../config/contato.ts';
import { marca } from '../../config/marca.ts';
import { consentimento, rodape, whatsapp } from '../../content/textos/index.ts';
import { linkWhatsApp } from '../../lib/whatsapp.ts';

const end = contato.endereco.valor;
const rt = marca.responsavelTecnico.valor;
const cnpj = marca.cnpj.valor;
---

<footer class="rodape" data-cta-origem="rodape">
  <div class="rodape__quadro">
    <div class="rodape__marca">
      <a href="/" aria-label="Prime House Academia, início">
        <Logo variante="empilhado" altura={72} decorativo />
      </a>
      <p class="rodape__tagline">{rodape.tagline}</p>
    </div>
    <div>
      <h2 class="t-rotulo rodape__titulo">{rodape.enderecoTitulo}</h2>
      <address>
        {end.logradouro}, {end.numero}
        <br />
        {end.bairro}, {end.cidade}/{end.uf}
        <br />
        CEP {end.cep}
      </address>
    </div>
    <div>
      <h2 class="t-rotulo rodape__titulo">{rodape.horarioTitulo}</h2>
      <ul class="rodape__lista t-tabular">
        {rodape.horarioResumo.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="t-rotulo rodape__titulo">{rodape.contatoTitulo}</h2>
      <ul class="rodape__lista">
        <li>
          <Link href={linkWhatsApp(whatsapp.geral)}>WhatsApp {contato.telefone.valor}</Link>
        </li>
        <li>
          <Link href={`tel:${contato.telefoneE164.valor}`}>Telefone {contato.telefone.valor}</Link>
        </li>
        <li>
          <Link href={contato.instagram.valor.url}>
            Instagram @{contato.instagram.valor.usuario}
          </Link>
        </li>
      </ul>
    </div>
    <nav aria-label="Rodapé">
      <h2 class="t-rotulo rodape__titulo">{rodape.linksTitulo}</h2>
      <ul class="rodape__lista">
        {rodape.links.map((l) => (
          <li>
            <Link href={l.href}>{l.rotulo}</Link>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="rodape__legal t-pequeno">
    <span>
      {rodape.responsavelTecnico.replace('{nome}', rt.nome)}
      {rt.cref && rodape.cref.replace('{cref}', rt.cref)}
    </span>
    <span>{rodape.cnpj.replace('{cnpj}', cnpj)}</span>
    <span>{rodape.direitos}</span>
    <button type="button" class="rodape__pref" data-preferencias hidden>
      {`${consentimento.preferencias}: `}
      <span
        data-preferencias-estado
        data-aceito={consentimento.estado.aceito}
        data-recusado={consentimento.estado.recusado}
        data-nenhum={consentimento.estado.nenhum}
      ></span>
    </button>
  </div>
  <Consentimento />
</footer>

<style>
  .rodape {
    border-top: 1px solid var(--prime-linha);
    padding: var(--esp-8) var(--margem) var(--esp-6);
    background: var(--prime-breu);
  }
  .rodape__quadro {
    width: min(100%, var(--largura-max));
    margin-inline: auto;
    display: grid;
    gap: var(--esp-6);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .rodape__marca {
    display: grid;
    gap: var(--esp-4);
    align-content: start;
    color: var(--prime-nevoa);
  }
  .rodape__marca a {
    color: inherit;
    justify-self: start;
  }
  .rodape__tagline {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: 1.25rem;
  }
  .rodape__titulo {
    color: var(--prime-concreto);
    margin-bottom: var(--esp-3);
  }
  .rodape address {
    font-style: normal;
  }
  .rodape__lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-2);
  }
  .rodape__pref {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
  }
  .rodape__pref:hover {
    color: var(--prime-luz);
  }
  .rodape__legal {
    width: min(100%, var(--largura-max));
    margin: var(--esp-7) auto 0;
    padding-top: var(--esp-4);
    border-top: 1px solid var(--prime-linha);
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-6);
    color: var(--prime-concreto);
  }
</style>
