---
// 3 · A CASA EM 3D (teaser) — gesto: um pôster escuro com as molduras de luz; a maquete entra no lugar dele.
// Mesma ilha da /a-casa (import dinâmico, fora do JS inicial). Nunca carrega sozinha em Save-Data/2g/movimento reduzido.
import Botao from '../base/Botao.astro';
import Poster from '../base/Poster.astro';
import TetoDeLuz from '../marca/TetoDeLuz.astro';
import { aCasa, botoes } from '../../content/textos/index.ts';
import Secao from './Secao.astro';
import { modoAtual } from '../../config/modo.ts';
import { exibir } from '../../config/tipos.ts';
import { tour3d } from '../../config/tour3d.ts';
import { maqueteEsquematicaNoBuild } from '../../tres/build.ts';

const esquematicaOk = exibir(tour3d.maqueteEsquematicaAprovada, modoAtual()) === true;
// sem planta e sem aprovação, o 3D não abre: o botão nem aparece (fica o pôster e o tour completo em HTML)
const tem3d = esquematicaOk || !maqueteEsquematicaNoBuild();

const destaque = ['musculacao', 'cardio', 'conveniencia'] as const;
---

<Secao id="a-casa" rotulo="A Casa em 3D" titulo={aCasa.intro.titulo} class="teaser">
  <div
    class="teaser__palco"
    data-tour3d
    data-esquematica-ok={String(esquematicaOk)}
    data-modulo="__PH_TOUR_URL__"
  >
    <div class="teaser__poster">
      <div class="teaser__fundo" aria-hidden="true">
        <Poster
          id="captura-10"
          alt=""
          sizes="(min-width: 64rem) 60vw, 100vw"
          class="teaser__foto"
        />
        <TetoDeLuz intensidade="plena" class="teaser__teto" />
      </div>
      <div class="teaser__alvo" data-tour3d-alvo></div>
      <p class="teaser__selo t-rotulo">Representação esquemática — em breve, o tour real</p>
    </div>
    <div class="teaser__controles">
      <p class="t-pequeno teaser__como">{aCasa.intro.comoUsar}</p>
      <ul class="teaser__zonas" aria-label="Zonas">
        {destaque.map((z) => (
          <li>
            <a class="teaser__zona" href={`/a-casa?zona=${z}`} data-zona={z}>
              {aCasa.zonas[z].titulo}
            </a>
          </li>
        ))}
      </ul>
      <div class="teaser__acoes">
        {tem3d && (
          <button class="botao-carregar t-rotulo" type="button" data-tour3d-carregar>
            {botoes.carregarTour3d}
          </button>
        )}
        <Botao href="/a-casa" variante="secundario">
          {botoes.abrirTour}
        </Botao>
      </div>
      <p class="t-pequeno t-secundario teaser__aviso" data-tour3d-aviso hidden role="status"></p>
    </div>
  </div>
</Secao>

<script>
  import './teaser.ts';
</script>

<style>
  .teaser__palco {
    position: relative;
    display: grid;
    gap: var(--esp-5);
  }
  .teaser__poster {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--prime-grafite);
    border: 1px solid var(--prime-linha);
  }
  .teaser__poster :global(.teaser__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    opacity: 0.38;
    filter: grayscale(0.4);
  }
  .teaser__poster :global(.teaser__teto) {
    position: absolute;
    inset: 0;
    height: 100%;
    aspect-ratio: auto;
  }
  .teaser__fundo {
    position: absolute;
    inset: 0;
  }
  .teaser__alvo {
    position: absolute;
    inset: 0;
  }
  .teaser__alvo :global(.tour3d__canvas) {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }
  .teaser__alvo :global(.tour3d__rotulos) {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .teaser__alvo :global(.tour3d__rotulo) {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto;
    padding: 0.2rem 0.5rem;
    background: rgb(12 11 10 / 0.72);
    color: var(--prime-nevoa);
    border: 1px solid var(--prime-linha);
    font: 600 0.75rem/1.3 var(--fonte-texto);
    white-space: nowrap;
  }
  .teaser__alvo :global(.tour3d__rotulo.ativo) {
    border-color: var(--prime-luz);
    box-shadow: var(--luz-borda);
  }
  .teaser__palco[data-modo='3d'] .teaser__fundo {
    display: none;
  }
  .teaser__selo {
    display: none;
    position: absolute;
    top: var(--esp-3);
    left: var(--esp-3);
    margin: 0;
    padding: 0.35rem 0.6rem;
    background: rgb(12 11 10 / 0.82);
    color: var(--prime-luz);
    border: 1px solid rgb(255 244 224 / 0.45);
  }
  .teaser__palco[data-esquematica='sim'] .teaser__selo {
    display: block;
  }
  .teaser__controles {
    display: grid;
    gap: var(--esp-5);
    align-content: end;
  }
  .teaser__zonas {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2);
  }
  .teaser__zona {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    color: var(--prime-nevoa);
    text-decoration: none;
    border: 1px solid var(--prime-linha);
    transition:
      border-color var(--dur-1) var(--curva-saida),
      box-shadow var(--dur-1) var(--curva-saida);
  }
  .teaser__zona:hover {
    border-color: var(--prime-luz);
    box-shadow: var(--luz-borda);
  }
  .teaser__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
  }
  .botao-carregar {
    min-height: 3.25rem;
    padding: 0.9rem 1.5rem;
    background: var(--prime-luz);
    color: var(--prime-breu);
    border: 1px solid var(--prime-luz);
    transition: box-shadow var(--dur-1) var(--curva-saida);
  }
  .botao-carregar:hover {
    box-shadow: 0 0 18px rgb(255 244 224 / 0.45);
  }
  @media (min-width: 64rem) {
    .teaser__palco {
      grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr);
      align-items: end;
      gap: var(--esp-7);
    }
    .teaser__poster {
      aspect-ratio: 16 / 10;
    }
  }
</style>
