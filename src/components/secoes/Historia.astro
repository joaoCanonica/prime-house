---
// 9 · A HISTÓRIA — gesto: uma linha do tempo horizontal (vertical no celular) com 5 marcos de luz, e o Lucas em P&B.
// lucas-discurso e equipe: consentimento pendente → usa lucas-close (só o Lucas, autorizado).
import MolduraVideo from '../base/MolduraVideo.astro';
import { home, videos } from '../../content/textos/index.ts';
import Secao from './Secao.astro';
import Txt from './Txt.astro';

const h = home.historia;
---

<Secao id="historia" rotulo={h.rotulo} titulo={h.titulo} class="historia">
  <div class="historia__topo">
    <div class="historia__texto">
      <p class="t-lead">{h.intro}</p>
      <p class="historia__origem">{h.origem.texto}</p>
    </div>
    <figure class="historia__video">
      <MolduraVideo id="lucas-close" descricao={videos['lucas-close']} />
      <figcaption class="t-rotulo t-secundario">Lucas Moro · inauguração, 30/04/2026</figcaption>
    </figure>
  </div>
  <ol class="linha">
    {h.marcos.map((m) => (
      <li class="linha__marco">
        <span class="linha__ponto" aria-hidden="true" />
        <time class="t-rotulo linha__data" datetime={m.data}>
          {m.rotulo}
        </time>
        <h3 class="linha__titulo">{m.titulo}</h3>
        <Txt texto={m.texto} class="t-pequeno linha__texto" />
      </li>
    ))}
  </ol>
</Secao>

<style>
  .historia__topo {
    display: grid;
    gap: var(--esp-7);
    margin-bottom: var(--esp-8);
  }
  .historia__texto {
    display: grid;
    gap: var(--esp-5);
    align-content: start;
  }
  .historia__origem {
    font-family: var(--fonte-acento);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.3;
  }
  .historia__video {
    width: min(100%, 20rem);
    display: grid;
    gap: var(--esp-3);
  }
  .historia__video :global(video) {
    filter: grayscale(1);
  }
  .linha {
    list-style: none;
    padding: 0 0 0 var(--esp-5);
    display: grid;
    gap: var(--esp-6);
    position: relative;
  }
  .linha::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.4rem;
    bottom: 0.4rem;
    width: 1px;
    background: rgb(255 244 224 / 0.45);
  }
  .linha__marco {
    position: relative;
    display: grid;
    gap: var(--esp-1);
    max-width: 30ch;
  }
  .linha__ponto {
    position: absolute;
    left: calc(-1 * var(--esp-5) - 4px);
    top: 0.3rem;
    width: 9px;
    height: 9px;
    background: var(--prime-luz);
    box-shadow: 0 0 10px rgb(255 244 224 / 0.8);
  }
  .linha__marco:last-child .linha__ponto {
    background: var(--prime-laranja);
    box-shadow: 0 0 10px rgb(236 138 42 / 0.7);
  }
  .linha__data {
    color: var(--prime-concreto);
  }
  .linha__titulo {
    font-weight: 600;
    font-size: 1.125rem;
  }
  .linha :global(.linha__texto) {
    color: var(--prime-concreto);
  }
  @media (min-width: 64rem) {
    .historia__topo {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
    .historia__video {
      justify-self: end;
    }
    .linha {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      padding: var(--esp-6) 0 0;
      gap: var(--esp-5);
    }
    .linha::before {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .linha__ponto {
      left: 0;
      top: calc(-1 * var(--esp-6) - 4px);
    }
  }
</style>
