---
// 6 · CONFORTO — gesto: grade assimétrica e escura de recortes reais; o hover acende a moldura de cada um.
import Poster from '../base/Poster.astro';
import { alt, home } from '../../content/textos/index.ts';
import Secao from './Secao.astro';

const s = home.conforto;
// climatização não tem recorte próprio: usa a captura 06 (sala com ar-condicionado), no máx. 480 px
const imagem = (id: string, midia: string | null) =>
  midia ?? (id === 'climatizacao' ? 'captura-06' : null);
const altDe = (id: string) => (alt as Record<string, string>)[id] ?? '';
---

<Secao id="conforto" rotulo={s.rotulo} titulo={s.titulo} class="conforto">
  <ul class="conforto__grade">
    {s.itens.map((item, i) => {
      const m = imagem(item.id, item.midia);
      return (
        <li class={`conforto__item conforto__item--${i + 1}`} style={{ gridArea: item.id }}>
          <figure>
            {m && (
              <Poster
                id={m}
                alt={altDe(m)}
                sizes="(min-width: 64rem) 30vw, 50vw"
                class="conforto__foto"
              />
            )}
            <figcaption>
              <span class="conforto__titulo">{item.titulo}</span>
              <span class="conforto__legenda t-pequeno">{item.legenda}</span>
            </figcaption>
          </figure>
        </li>
      );
    })}
  </ul>
</Secao>

<style>
  .conforto__grade {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
  }
  .conforto__item {
    max-width: none;
  }
  .conforto__item figure {
    position: relative;
    height: 100%;
    min-height: 13rem;
    display: grid;
    align-content: end;
    overflow: hidden;
    background: var(--prime-grafite);
    outline: 1px solid var(--prime-linha);
    outline-offset: -1px;
    transition:
      outline-color var(--dur-1) var(--curva-saida),
      box-shadow var(--dur-1) var(--curva-saida);
  }
  .conforto__item figure:hover {
    outline-color: var(--prime-luz);
    box-shadow: 0 0 18px rgb(255 244 224 / 0.22);
  }
  .conforto__item :global(.conforto__foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    filter: brightness(0.62) saturate(0.85);
    transition: filter var(--dur-3) var(--curva-saida);
  }
  .conforto__item figure:hover :global(.conforto__foto) {
    filter: brightness(0.8) saturate(1);
  }
  .conforto__item figcaption {
    position: relative;
    display: grid;
    gap: 0.15rem;
    padding: var(--esp-4);
    background: rgb(12 11 10 / 0.8);
  }
  .conforto__titulo {
    font-weight: 600;
  }
  .conforto__legenda {
    color: var(--prime-nevoa);
    opacity: 0.85;
    max-width: 32ch;
  }
  /* celular: 2 colunas, café e esteira na largura toda */
  .conforto__grade {
    grid-template-areas:
      'cafe cafe'
      'lanches geladeira'
      'banheiro climatizacao'
      'esteira esteira'
      'kids app';
  }
  .conforto__item--1 figure {
    min-height: 20rem;
  }
  /* desktop: 16 células exatas, sem buracos */
  @media (min-width: 64rem) {
    .conforto__grade {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 15rem;
      grid-template-areas:
        'cafe cafe lanches geladeira'
        'cafe cafe banheiro geladeira'
        'esteira esteira banheiro climatizacao'
        'app kids kids climatizacao';
    }
    .conforto__item figure,
    .conforto__item--1 figure {
      min-height: 0;
    }
  }
</style>
