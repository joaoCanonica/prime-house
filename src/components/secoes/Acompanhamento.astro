---
// 4 · ACOMPANHAMENTO DE VERDADE — gesto: um checklist. Marcar os sinais acende cada linha; o resultado sugere a
// avaliação funcional e monta a mensagem do WhatsApp. Nada é guardado (só existe nesta página).
// Vídeo "acompanhamento": consentimento pendente → still sem rostos (anilha).
import Poster from '../base/Poster.astro';
import IconeWhatsApp from '../base/IconeWhatsApp.astro';
import MolduraLuz from '../marca/MolduraLuz.astro';
import { home, whatsapp } from '../../content/textos/index.ts';
import { linkWhatsApp } from '../../lib/whatsapp.ts';
import Secao from './Secao.astro';

const q = home.acompanhamento.quiz;
---

<Secao
  id="acompanhamento"
  rotulo={home.acompanhamento.rotulo}
  titulo={home.acompanhamento.titulo}
  class="acomp"
>
  <div class="acomp__grade">
    <form class="quiz" data-quiz aria-labelledby="quiz-titulo">
      <h3 id="quiz-titulo" class="t-h3">
        {q.titulo.texto}
      </h3>
      <p class="t-pequeno t-secundario">{q.instrucao}</p>
      <ul class="quiz__lista">
        {q.sinais.map((s, i) => (
          <li>
            <label class="quiz__item">
              <input type="checkbox" name="sinal" value={s.texto} data-quiz-sinal />
              <span class="quiz__caixa" aria-hidden="true" />
              <span class="quiz__n t-tabular" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span>{s.texto}</span>
            </label>
          </li>
        ))}
      </ul>
      <div class="quiz__resultado" aria-live="polite">
        <p class="t-lead" data-quiz-nenhum>
          {q.resultadoNenhum}
        </p>
        <p class="t-lead" data-quiz-algum hidden>
          {q.resultadoAlgum.texto}
        </p>
      </div>
      <a
        class="botao-quiz"
        href={linkWhatsApp(whatsapp.avaliacao)}
        target="_blank"
        rel="noopener"
        data-quiz-link
        data-cta-origem="quiz"
      >
        <IconeWhatsApp />
        <span>{q.botao}</span>
        <span class="sr-only"> no WhatsApp (abre em nova aba)</span>
      </a>
    </form>
    <figure class="acomp__foto">
      <MolduraLuz forma="hexagono" proporcao="9 / 14">
        <Poster
          id="still-anilha"
          alt="Anilha preta encaixada na barra, em close"
          sizes="(min-width: 64rem) 28vw, 80vw"
        />
      </MolduraLuz>
    </figure>
  </div>
</Secao>

<script>
  import './quiz.ts';
</script>

<style>
  .acomp__grade {
    display: grid;
    gap: var(--esp-8);
  }
  .quiz {
    display: grid;
    gap: var(--esp-5);
    max-width: 44rem;
  }
  .quiz__lista {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--prime-linha);
  }
  .quiz__lista li {
    max-width: none;
    border-bottom: 1px solid var(--prime-linha);
  }
  .quiz__item {
    display: grid;
    grid-template-columns: auto auto 1fr;
    gap: var(--esp-4);
    align-items: center;
    padding: var(--esp-4) var(--esp-2);
    cursor: pointer;
    transition: background-color var(--dur-2) var(--curva-saida);
  }
  .quiz__item input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .quiz__caixa {
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid rgb(255 244 224 / 0.55);
    transition:
      background-color var(--dur-1) var(--curva-saida),
      box-shadow var(--dur-1) var(--curva-saida);
  }
  .quiz__n {
    color: var(--prime-concreto);
    font-size: var(--fs-pequeno);
  }
  .quiz__item:hover .quiz__caixa {
    border-color: var(--prime-luz);
    box-shadow: var(--luz-borda);
  }
  .quiz__item:has(input:checked) {
    background: rgb(255 244 224 / 0.05);
  }
  .quiz__item:has(input:checked) .quiz__caixa {
    background: var(--prime-luz);
    border-color: var(--prime-luz);
    box-shadow: 0 0 10px rgb(255 244 224 / 0.6);
  }
  .quiz__item:has(input:focus-visible) {
    outline: 1px solid var(--prime-luz);
    outline-offset: 2px;
  }
  .quiz__resultado p[hidden] {
    display: none;
  }
  .botao-quiz {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    justify-self: start;
    min-height: 3.25rem;
    padding: 0.9rem 1.5rem;
    background: var(--prime-laranja);
    color: var(--prime-breu);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: box-shadow var(--dur-1) var(--curva-saida);
  }
  .botao-quiz:hover {
    box-shadow:
      0 0 0 1px var(--prime-breu),
      0 0 0 2px var(--prime-luz),
      0 0 16px 1px rgb(255 244 224 / 0.3);
  }
  .acomp__foto {
    width: min(100%, 22rem);
    justify-self: center;
  }
  @media (min-width: 64rem) {
    .acomp__grade {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: center;
    }
  }
</style>
