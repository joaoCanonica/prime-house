---
// 8 · O QUE DIZEM — gesto: três citações lado a lado, cada uma aberta por um fio de luz; literais, com selo e
// link do Google. Sem nota agregada.
import Botao from '../base/Botao.astro';
import Citacao from '../base/Citacao.astro';
import { avaliacoes } from '../../config/avaliacoes.ts';
import { botoes, home } from '../../content/textos/index.ts';
import Secao from './Secao.astro';

const lista = home.prova.avaliacoes
  .map((id) => avaliacoes.selecionadas.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => !!a);
---

<Secao id="o-que-dizem" rotulo={home.prova.rotulo} titulo={home.prova.titulo} class="dizem">
  <ul class="dizem__lista">
    {lista.map((a) => (
      <li>
        <Citacao avaliacao={a} />
      </li>
    ))}
  </ul>
  <Botao href={avaliacoes.urlFicha} variante="secundario">
    {botoes.avaliarGoogle}
  </Botao>
</Secao>

<style>
  .dizem__lista {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--esp-7);
    margin-bottom: var(--esp-7);
  }
  .dizem__lista li {
    position: relative;
    max-width: none;
    padding-top: var(--esp-5);
    border-top: 1px solid var(--prime-linha);
  }
  .dizem__lista li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 3.5rem;
    height: 1px;
    background: var(--prime-luz);
    box-shadow: 0 0 8px rgb(255 244 224 / 0.6);
  }
  @media (min-width: 64rem) {
    .dizem__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--esp-6);
    }
    .dizem__lista li :global(.citacao) {
      height: 100%;
      grid-template-rows: 1fr auto;
    }
    .dizem__lista li :global(.citacao__texto) {
      font-size: clamp(1.375rem, 0.9rem + 0.9vw, 1.875rem);
    }
  }
</style>
