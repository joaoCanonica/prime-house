---
// 2 · NÚMEROS — gesto: quatro números verificáveis em linha, separados por fios de luz.
// Horário: config/horario.ts (seg–sex 5h–0h; sáb; dom e feriados). "14 dias de garantia": confirmado pelo João (08/11/2026).
import NumeroGrande from '../marca/NumeroGrande.astro';
import { home } from '../../content/textos/index.ts';

const cores = ['nevoa', 'luz', 'nevoa', 'laranja'] as const;
---

<section id="numeros" class="numeros" aria-label={home.numeros.rotulo}>
  <ul class="numeros__lista">
    {home.numeros.itens.map((n, i) => (
      <li>
        <NumeroGrande
          valor={n.valor}
          unidade={'unidade' in n ? n.unidade : undefined}
          legenda={n.legenda}
          cor={cores[i] ?? 'nevoa'}
        />
      </li>
    ))}
  </ul>
</section>

<style>
  .numeros {
    padding: var(--secao) var(--margem);
    border-top: 1px solid var(--prime-linha);
  }
  .numeros__lista {
    list-style: none;
    padding: 0;
    width: min(100%, var(--largura-max));
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* mesma escala para os quatro (a do mais largo, "100%"): números do mesmo tamanho */
  .numeros__lista :global(.numero-grande) {
    --numero-em: 2.2 !important;
  }
  .numeros__lista li {
    position: relative;
    max-width: none;
    padding: var(--esp-6) var(--esp-4);
    display: grid;
    align-items: end;
  }
  /* fios de luz entre os números */
  .numeros__lista li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 12%;
    bottom: 12%;
    width: 1px;
    background: var(--prime-luz);
    box-shadow: 0 0 6px rgb(255 244 224 / 0.45);
    opacity: 0.7;
  }
  .numeros__lista li:nth-child(odd)::before {
    display: none;
  }
  .numeros__lista li:nth-child(n + 3) {
    border-top: 1px solid rgb(255 244 224 / 0.35);
  }
  @media (min-width: 64rem) {
    .numeros__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .numeros__lista li {
      padding: var(--esp-4) clamp(1rem, 2vw, 2.5rem);
    }
    .numeros__lista li:nth-child(odd)::before {
      display: block;
    }
    .numeros__lista li:first-child::before {
      display: none;
    }
    .numeros__lista li:nth-child(n + 3) {
      border-top: 0;
    }
  }
</style>
