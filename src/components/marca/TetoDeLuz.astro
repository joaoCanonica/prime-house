---
// Teto de luz: as luminárias do teto (retângulos e hexágonos alongados em fileiras), vistas de baixo
// em perspectiva de um ponto, como nas capturas 01 e 06–13. Gerado no build: SVG estático, sem JS próprio.
interface Props {
  /** liga uma moldura por vez (abertura). Sem isso, todas cintilam juntas. */
  sequencial?: boolean;
  /** "fundo" = discreto, para seções escuras */
  intensidade?: 'plena' | 'fundo';
  class?: string | undefined;
}
const { sequencial = false, intensidade = 'plena', class: classe } = Astro.props;

const W = 1600;
const H = 900;
const cx = W / 2;
const horizonte = H * 0.86;
const focal = 980;
const altura = 3.2; // teto acima dos olhos (unidade arbitrária)
const colunas = [-10.5, -5.25, 0, 5.25, 10.5];
const fileiras = [3.2, 5.4, 7.6, 9.8, 12, 14.2, 16.4, 18.6, 20.8];
const largura = 3.6;
const profundidade = 1.5;

const projetar = (x: number, z: number) => {
  const sx = cx + (focal * x) / z;
  const sy = horizonte - (focal * altura) / z;
  return `${Math.round(sx * 10) / 10},${Math.round(sy * 10) / 10}`;
};

interface Luminaria {
  pontos: string;
  z: number;
  x: number;
  forma: 'hexagono' | 'retangulo';
}
const luminarias: Luminaria[] = [];
fileiras.forEach((z, f) => {
  colunas.forEach((x, c) => {
    const forma = (f + c) % 3 === 0 ? 'hexagono' : 'retangulo';
    const x0 = x - largura / 2;
    const x1 = x + largura / 2;
    const z0 = z;
    const z1 = z + profundidade;
    const zm = (z0 + z1) / 2;
    const ponta = 0.55;
    const vertices: [number, number][] =
      forma === 'hexagono'
        ? [
            [x0 + ponta, z0],
            [x1 - ponta, z0],
            [x1, zm],
            [x1 - ponta, z1],
            [x0 + ponta, z1],
            [x0, zm],
          ]
        : [
            [x0, z0],
            [x1, z0],
            [x1, z1],
            [x0, z1],
          ];
    luminarias.push({
      pontos: vertices.map(([vx, vz]) => projetar(vx, vz)).join(' '),
      z,
      x,
      forma,
    });
  });
});
// ordem de acendimento: de perto para longe, do centro para as laterais
luminarias.sort((a, b) => a.z - b.z || Math.abs(a.x) - Math.abs(b.x));
const zMax = fileiras[fileiras.length - 1] ?? 1;
---

<div
  class:list={['teto-de-luz', `teto-de-luz--${intensidade}`, classe]}
  data-luz
  style={{ '--luz-passo': sequencial ? '55ms' : '0ms' }}
  aria-hidden="true"
>
  <svg
    class="luz-svg"
    viewBox={`0 0 ${W} ${H}`}
    preserveAspectRatio="xMidYMin slice"
    focusable="false"
  >
    {luminarias.map((l, i) => (
      <polygon
        class="luz-led"
        points={l.pontos}
        style={{ '--i': i, strokeOpacity: (1 - (l.z / zMax) * 0.55).toFixed(2) }}
      />
    ))}
  </svg>
</div>

<script>
  import '../../scripts/luz.ts';
</script>

<style>
  .teto-de-luz {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    pointer-events: none;
  }
  .teto-de-luz svg {
    width: 100%;
    height: 100%;
  }
  .teto-de-luz--fundo {
    opacity: 0.32;
  }
</style>
