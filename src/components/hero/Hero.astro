---
// Hero da home. Celular: um vídeo de tela cheia (a sala com as molduras de LED). Desktop: tríptico de três
// vídeos verticais reais lado a lado, separados por fios de luz (treino com professor · a sala · leg press),
// em resolução nativa (as fontes são verticais 720×1280). O pôster central é o LCP; os vídeos entram depois
// (ou quando a abertura manda). Texto grande por cima, na família do título.
import Botao from '../base/Botao.astro';
import BotaoWhatsApp from '../base/BotaoWhatsApp.astro';
import { video } from '../base/midia.ts';
import Rotulo from '../base/Rotulo.astro';
import StatusHorario from '../base/StatusHorario.astro';
import Logo from '../marca/Logo.astro';
import { contato } from '../../config/contato.ts';
import { mensagens } from '../../lib/whatsapp.ts';

interface Props {
  midia?: 'interior-noite' | 'drone-noite';
}
const { midia = 'interior-noite' } = Astro.props;

const PAINEIS = [
  {
    id: 'rotina-hack',
    lado: true,
    alt: 'Aluno treinando na máquina hack com o professor ao lado',
  },
  {
    id: midia,
    lado: false,
    alt:
      midia === 'interior-noite'
        ? 'Sala de musculação da Prime House à noite: máquinas Cimerian sob as molduras de LED do teto'
        : 'Vista aérea noturna da fachada da Prime House, com o letreiro aceso',
  },
  { id: 'rotina-legpress', lado: true, alt: 'Aluna no leg press Cimerian, diante das janelas' },
] as const;

const paineis = PAINEIS.map((p) => {
  const v = video(p.id);
  const p540 = v.posters.find((x) => x.nome === 'poster-540');
  const p720 = v.posters.find((x) => x.nome === 'poster-720');
  if (!p540 || !p720) throw new Error(`[hero] "${p.id}" sem pôster vertical`);
  const fontes = v.variantes
    .filter((x) => !x.horizontal && !x.som)
    .sort((a, b) => a.altura - b.altura || (a.formato === 'webm' ? -1 : 1));
  return { ...p, v, p540, p720, fontes };
});
const end = contato.endereco.valor;
---

<section class="hero" data-hero aria-labelledby="hero-titulo">
  <header class="hero__topo">
    <a class="hero__logo" href="/" data-logo-destino>
      <Logo variante="linha" altura={22} decorativo />
      <span class="sr-only">Prime House Academia, início</span>
    </a>
  </header>

  <div class="hero__palco" data-hero-palco>
    {paineis.map((p) => (
      <div
        class:list={['hero__painel', { 'hero__painel--lado': p.lado }]}
        {...(p.lado ? {} : { 'data-hero-midia': '' })}
      >
        <picture class="hero__poster" style={{ backgroundImage: `url(${p.v.lqip})` }}>
          <source type="image/avif" media="(max-width: 600px)" srcset={p.p540.avif} />
          <source type="image/avif" srcset={p.p720.avif} />
          <source type="image/webp" media="(max-width: 600px)" srcset={p.p540.webp} />
          <img
            src={p.p720.webp}
            width="720"
            height="1280"
            alt={p.alt}
            {...(p.lado
              ? { loading: 'lazy', fetchpriority: 'low' }
              : { loading: 'eager', fetchpriority: 'high' })}
            decoding="async"
          />
        </picture>
        <video
          class="hero__video"
          muted
          playsinline
          loop
          preload="none"
          aria-hidden="true"
          data-hero-video
          {...(p.lado ? { 'data-lado': '' } : {})}
        >
          {p.fontes.map((x) => (
            <source
              src={x.arquivo}
              type={`video/${x.formato}`}
              media={x.altura < 1280 ? '(max-width: 600px)' : undefined}
            />
          ))}
        </video>
      </div>
    ))}
    <button class="hero__pausa t-rotulo" type="button" data-hero-pausa hidden>
      <span data-rotulo-pausar>Pausar vídeo</span>
      <span data-rotulo-tocar hidden>
        Tocar vídeo
      </span>
    </button>
  </div>

  <div class="hero__texto">
    <Rotulo ponto>Musculação · Trânsito livre · Lages</Rotulo>
    <h1 class="hero__titulo" id="hero-titulo" tabindex="-1">
      O novo <span class="acento">padrão</span> de treino em Lages.
    </h1>
    <p class="hero__apoio t-lead" data-entra>
      100% maquinário Cimerian, atendimento de verdade e um espaço pensado para você querer voltar
      amanhã.
    </p>
    <div class="hero__acoes" data-entra>
      <BotaoWhatsApp mensagem={mensagens.geral} origem="hero" />
      <Botao href="#a-casa" variante="secundario">
        Fazer o tour
      </Botao>
    </div>
  </div>

  <div class="hero__info" data-entra>
    <StatusHorario />
    <p class="t-pequeno hero__endereco">
      {end.logradouro}, {end.numero}
      <br />
      {end.bairro} · {end.cidade}/{end.uf}
    </p>
  </div>
</section>

<script>
  import './hero.ts';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto auto;
    gap: var(--esp-6);
    padding: var(--esp-5) var(--margem) var(--esp-7);
    overflow: clip;
  }
  .hero__topo {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
  }
  .hero__logo {
    display: inline-flex;
    color: var(--prime-nevoa);
    padding: var(--esp-2) 0;
  }

  /* ----- palco: no celular, um painel de tela cheia ----- */
  .hero__palco {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .hero__painel {
    position: relative;
    overflow: hidden;
  }
  .hero__painel--lado {
    display: none;
  }
  .hero__palco::after {
    /* véu uniforme (não é degradê) para o texto ler sobre o vídeo */
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(12 11 10 / 0.5);
    pointer-events: none;
  }
  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__poster {
    display: block;
    background-size: cover;
    background-position: center;
  }
  .hero__poster img,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__video {
    opacity: 0;
    transition: opacity var(--dur-3) var(--curva-saida);
  }
  .hero__video:global(.tocando) {
    opacity: 1;
  }
  .hero__pausa {
    position: absolute;
    z-index: 3;
    top: var(--esp-5);
    right: var(--margem);
    min-height: 2.75rem;
    padding: var(--esp-2) var(--esp-3);
    background: rgb(12 11 10 / 0.6);
    color: var(--prime-nevoa);
    border: 1px solid rgb(255 244 224 / 0.35);
    transition:
      border-color var(--dur-1) var(--curva-saida),
      box-shadow var(--dur-1) var(--curva-saida);
  }
  .hero__pausa:hover {
    border-color: var(--prime-luz);
    box-shadow: var(--luz-borda);
  }

  /* ----- texto ----- */
  .hero__texto {
    grid-row: 3;
    display: grid;
    gap: var(--esp-5);
    align-content: end;
  }
  .hero__titulo {
    font-family: var(--fonte-titulo);
    font-stretch: var(--largura-display);
    font-weight: 780;
    text-transform: uppercase;
    font-size: clamp(3.25rem, 1.4rem + 7.6vw, 7.5rem);
    line-height: 0.88;
    letter-spacing: -0.01em;
    max-width: 10ch;
  }
  .hero__titulo:focus {
    outline: none;
  }
  .hero__apoio {
    max-width: 34ch;
    color: var(--prime-nevoa);
  }
  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
    margin-top: var(--esp-2);
  }
  .hero__info {
    grid-row: 4;
    display: grid;
    gap: var(--esp-2);
    padding-top: var(--esp-4);
    border-top: 1px solid var(--prime-linha);
  }
  .hero__endereco {
    color: var(--prime-nevoa);
    opacity: 0.86;
  }

  /* ----- desktop: tríptico de tela cheia, fios de luz entre os painéis ----- */
  @media (min-width: 64rem) {
    .hero {
      height: 100svh;
      min-height: 42rem;
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      grid-template-rows: auto minmax(0, 1fr);
      column-gap: var(--esp-8);
      padding: var(--esp-5) var(--margem) var(--margem);
    }
    .hero__topo {
      grid-column: 1 / -1;
    }
    .hero__palco {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1px;
      background: rgb(255 244 224 / 0.55);
      box-shadow: 0 0 18px rgb(255 244 224 / 0.12);
    }
    .hero__painel--lado {
      display: block;
    }
    .hero__palco::after {
      background: rgb(12 11 10 / 0.58);
    }
    .hero__pausa {
      top: auto;
      right: var(--margem);
      bottom: calc(var(--margem) + 9rem);
    }
    .hero__texto {
      grid-column: 1;
      grid-row: 2;
      gap: var(--esp-4);
    }
    .hero__titulo {
      font-size: clamp(3.25rem, 0.5rem + 4.2vw, 6.25rem);
      max-width: 11ch;
    }
    .hero__info {
      grid-column: 2;
      grid-row: 2;
      align-self: end;
    }
  }
</style>
