{
  "name": "primehouse-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Site da Prime House Academia (Lages/SC): Astro estático com ilha 3D.",
  "engines": {
    "node": ">=24.12.0",
    "pnpm": ">=10.28.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "predev": "node scripts/prepare-media.mjs && node scripts/model-prepare.mjs && node scripts/validate-config.mjs",
    "prebuild": "node scripts/prepare-media.mjs && node scripts/model-prepare.mjs && node scripts/validate-config.mjs",
    "dev": "astro dev",
    "build": "astro build",
    "build:producao": "MODO=producao pnpm build",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check . && node scripts/audit-contraste.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "validate-config": "node scripts/validate-config.mjs",
    "audit-compliance": "node scripts/audit-compliance.mjs",
    "audit-a11y": "node scripts/pendente.mjs audit-a11y 9",
    "audit-lighthouse": "node scripts/pendente.mjs audit-lighthouse 9",
    "audit-seo": "node scripts/pendente.mjs audit-seo 8",
    "audit-contraste": "node scripts/audit-contraste.mjs",
    "audit-pesos": "node scripts/pendente.mjs audit-pesos 6B",
    "media:prepare": "node scripts/prepare-media.mjs",
    "model:prepare": "node scripts/model-prepare.mjs",
    "capturar": "node scripts/capturar.mjs",
    "media:stills": "node scripts/extract-stills.mjs --folhas",
    "postbuild": "node scripts/ligar-tour.mjs && node scripts/audit-compliance.mjs",
    "icones": "node scripts/gerar-icones.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "astro": "7.4.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@eslint/js": "10.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playcanvas/splat-transform": "3.10.3",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "ajv": "8.20.0",
    "astro-eslint-parser": "3.2.0",
    "draco3dgltf": "1.5.9",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "meshoptimizer": "1.3.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
