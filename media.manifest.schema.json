{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://primehouse.local/media.manifest.schema.json",
  "title": "Manifesto de mídia da Prime House",
  "type": "object",
  "additionalProperties": false,
  "required": ["versao", "atualizado", "originais", "trechos", "stills", "recortes"],
  "properties": {
    "$schema": { "type": "string" },
    "versao": { "const": 1 },
    "atualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nota": { "type": "string" },
    "originais": { "type": "array", "items": { "$ref": "#/$defs/original" } },
    "trechos": { "type": "array", "items": { "$ref": "#/$defs/trecho" } },
    "stills": { "type": "array", "items": { "$ref": "#/$defs/still" } },
    "recortes": { "type": "array", "items": { "$ref": "#/$defs/recorte" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "consentimento": { "enum": ["pendente", "autorizado", "nao-precisa"] },
    "resolucao": {
      "type": "object",
      "additionalProperties": false,
      "required": ["largura", "altura"],
      "properties": {
        "largura": { "type": "integer", "minimum": 1 },
        "altura": { "type": "integer", "minimum": 1 }
      }
    },
    "pessoa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quem", "consentimento"],
      "properties": {
        "quem": { "type": "string", "minLength": 1 },
        "consentimento": { "$ref": "#/$defs/consentimento" }
      }
    },
    "comum": {
      "type": "object",
      "required": [
        "id",
        "uso",
        "resolucaoMax",
        "consentimento",
        "pessoas",
        "audioLiberado",
        "problemas",
        "edicoes",
        "naoUsar"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "uso": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "resolucaoMax": { "anyOf": [{ "$ref": "#/$defs/resolucao" }, { "type": "null" }] },
        "consentimento": { "$ref": "#/$defs/consentimento" },
        "pessoas": { "type": "array", "items": { "$ref": "#/$defs/pessoa" } },
        "audioLiberado": { "type": "boolean" },
        "problemas": { "type": "array", "items": { "type": "string" } },
        "edicoes": { "type": "array", "items": { "type": "string" } },
        "naoUsar": { "type": "boolean" },
        "motivoNaoUsar": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "naoUsar": { "const": true } } },
      "then": {
        "required": ["motivoNaoUsar"],
        "properties": { "motivoNaoUsar": { "type": "string" } }
      }
    },
    "original": {
      "allOf": [{ "$ref": "#/$defs/comum" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["arquivo", "tipo", "post", "texto", "fala", "resolucaoOriginal"],
      "properties": {
        "numero": { "type": "integer", "minimum": 0 },
        "arquivo": { "type": "string", "pattern": "^media-originais/" },
        "tipo": { "enum": ["video", "captura", "arte-instagram", "marca"] },
        "post": { "type": ["string", "null"] },
        "texto": { "type": ["string", "null"] },
        "fala": { "type": ["string", "null"] },
        "descricao": { "type": "string" },
        "resolucaoOriginal": { "anyOf": [{ "$ref": "#/$defs/resolucao" }, { "type": "null" }] },
        "duracao": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "trecho": {
      "allOf": [{ "$ref": "#/$defs/comum" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "origem",
        "natureza",
        "in",
        "out",
        "pedido",
        "ajuste",
        "posterEm",
        "loop",
        "inteiro",
        "fala",
        "saidas"
      ],
      "properties": {
        "origem": { "$ref": "#/$defs/id" },
        "natureza": { "const": "trecho-de-video" },
        "in": { "type": "number", "minimum": 0 },
        "out": { "type": "number", "exclusiveMinimum": 0 },
        "pedido": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["in", "out"],
              "properties": { "in": { "type": "number" }, "out": { "type": "number" } }
            },
            { "type": "null" }
          ]
        },
        "ajuste": { "type": ["string", "null"] },
        "posterEm": { "type": "number", "minimum": 0 },
        "loop": { "type": "boolean" },
        "inteiro": { "type": "boolean" },
        "fala": { "type": ["string", "null"] },
        "orcamentoBytes": { "type": "integer", "minimum": 1 },
        "saidas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alturas", "formatos"],
          "properties": {
            "alturas": { "type": "array", "items": { "enum": [1280, 960] }, "minItems": 1 },
            "formatos": { "type": "array", "items": { "enum": ["mp4", "webm"] }, "minItems": 1 }
          }
        },
        "horizontal16x9": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cortes"],
          "properties": {
            "cortes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ate", "y"],
                "properties": {
                  "ate": { "type": "number", "exclusiveMinimum": 0 },
                  "y": { "type": "integer", "minimum": 0, "maximum": 876 },
                  "vy": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "still": {
      "allOf": [{ "$ref": "#/$defs/comum" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["origem", "natureza", "t", "pedidoT", "ajuste"],
      "properties": {
        "origem": { "$ref": "#/$defs/id" },
        "natureza": { "const": "quadro de vídeo" },
        "t": { "type": "number", "minimum": 0 },
        "pedidoT": { "type": "number", "minimum": 0 },
        "ajuste": { "type": ["string", "null"] }
      }
    },
    "recorte": {
      "allOf": [{ "$ref": "#/$defs/comum" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["origem", "natureza", "caixa", "legendaOriginal"],
      "properties": {
        "origem": { "$ref": "#/$defs/id" },
        "natureza": { "const": "recorte" },
        "legendaOriginal": { "type": "string" },
        "caixa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "largura", "altura"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "largura": { "type": "integer", "minimum": 1 },
            "altura": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
